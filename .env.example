# Copy to .env for local overrides, or set these on your host. Every value is optional locally.

# PostgreSQL connection string. Leave unset to use the built-in PGlite database in ./data/pgdata.
# DATABASE_URL=postgres://cafe:cafe@localhost:5432/cafe

NODE_ENV=development
PORT=3000
# The address customers use; used to build links in emails.
PUBLIC_URL=http://localhost:3000
# Set to 1 when running behind NGINX or another single reverse proxy, so rate limits see real IPs.
# TRUST_PROXY=1

# Comma-separated emails that get the owner dashboard (menu, hours, café details, team, sales)
# and the staff order board. Accounts are promoted when they sign up or next log in.
OWNER_EMAILS=
# Comma-separated emails that get only the staff order board and sold-out switches.
STAFF_EMAILS=
# Or create an account directly: ADMIN_NAME=... ADMIN_EMAIL=... ADMIN_PASSWORD=... npm run admin:create

# Email delivery through Resend (https://resend.com). Without a key, emails are printed to the log.
# RESEND_API_KEY=
# MAIL_FROM=Little Lantern Café <orders@your-domain.com>

# Café details
# CAFE_NAME=Little Lantern Café
# CAFE_ADDRESS=14 Lavelle Road, Ashok Nagar, Bengaluru 560001
# CAFE_PHONE=+91 80 4000 1234
# CAFE_EMAIL=hello@littlelantern.cafe
# CAFE_TZ=Asia/Kolkata
# CAFE_CURRENCY=INR
# CAFE_LOCALE=en-IN
# CAFE_LAT=12.9698
# CAFE_LON=77.5986
